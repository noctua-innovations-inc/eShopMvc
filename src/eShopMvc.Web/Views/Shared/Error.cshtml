@model ErrorViewModel
@{
    ViewBag.Title = "Error";
}

@* Decision R-23: legacy text, inside the layout (legacy's full HTML document rendered nested in it).
   No exception details; the request id lets the error be matched to the logs. *@
<hgroup>
    <h1>Error.</h1>
    <h2>An error occurred while processing your request.</h2>
</hgroup>

@if (Model?.ShowRequestId == true)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}
