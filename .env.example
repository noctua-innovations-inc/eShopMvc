# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.

# SQL Server sa password: 8+ characters with upper case, lower case, digits and symbols.
# It is also placed in a connection string, so don't use ; ' " or $.
MSSQL_SA_PASSWORD=

# Optional: Development shows the developer exception page and readable logs (default Production).
# ASPNETCORE_ENVIRONMENT=
